generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  STAFF
  DELIVERY
}

enum ItemAvailability {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

enum SpiceLevel {
  NONE
  MILD
  MEDIUM
  HOT
}

enum AddressType {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD
}

enum PaymentMethod {
  RAZORPAY
  COD
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum RestaurantOpenStatus {
  OPEN
  CLOSED
}

enum GalleryKind {
  FOOD
  RESTAURANT
  KITCHEN
  AMBIENCE
}

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  phone                String?   @unique
  name                 String
  passwordHash         String
  role                 Role      @default(CUSTOMER)
  mustChangePassword   Boolean   @default(false)
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  addresses            Address[]
  cart                 Cart?
  orders               Order[]
  favorites            Favorite[]
  couponUsages         CouponUsage[]
  notifications        Notification[]
  contactMessages      ContactMessage[]

  @@index([role])
}

model Address {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType @default(HOME)
  label     String?
  name      String
  phone     String
  line1     String
  house     String?
  landmark  String?
  city      String
  state     String      @default("Uttar Pradesh")
  pincode   String
  isDefault Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
}

model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?
  imageKey    String
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  items       MenuItem[]

  @@index([sortOrder])
}

model MenuItem {
  id                    String           @id @default(uuid())
  name                  String
  slug                  String           @unique
  description           String?
  descriptionGenerated  Boolean          @default(false)
  price                 Decimal?         @db.Decimal(10, 2)
  categoryId            String
  category              Category         @relation(fields: [categoryId], references: [id])
  availability          ItemAvailability @default(AVAILABLE)
  isVegetarian          Boolean          @default(true)
  isPopular             Boolean          @default(false)
  isBestseller          Boolean          @default(false)
  isRecommended         Boolean          @default(false)
  isFeatured            Boolean          @default(false)
  spiceLevel            SpiceLevel       @default(NONE)
  prepTimeMinutes       Int?
  sortOrder             Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  images                MenuItemImage[]
  optionGroups          MenuItemOptionGroup[]
  addons                MenuItemAddon[]
  cartItems             CartItem[]
  orderItems            OrderItem[]
  favorites             Favorite[]

  @@index([categoryId, availability])
  @@index([isPopular])
  @@index([name])
}

model MenuItemImage {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  url        String
  alt        String
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([menuItemId])
}

model MenuItemOptionGroup {
  id         String           @id @default(uuid())
  menuItemId String
  menuItem   MenuItem         @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  required   Boolean          @default(false)
  minSelect  Int              @default(0)
  maxSelect  Int              @default(1)
  sortOrder  Int              @default(0)
  options    MenuItemOption[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model MenuItemOption {
  id        String               @id @default(uuid())
  groupId   String
  group     MenuItemOptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  priceDelta Decimal             @default(0) @db.Decimal(10, 2)
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model MenuItemAddon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Decimal  @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Cart {
  id          String     @id @default(uuid())
  userId      String?    @unique
  user        User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId   String?    @unique
  couponCode  String?
  items       CartItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([sessionId])
}

model CartItem {
  id                   String   @id @default(uuid())
  cartId               String
  cart                 Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId           String
  menuItem             MenuItem @relation(fields: [menuItemId], references: [id])
  quantity             Int      @default(1)
  specialInstructions  String?
  selectedOptions      Json     @default("[]")
  selectedAddons       Json     @default("[]")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([cartId])
}

model Order {
  id                        String        @id @default(uuid())
  orderNumber               String        @unique
  userId                    String?
  user                      User?         @relation(fields: [userId], references: [id])
  guestName                 String?
  guestPhone                String?
  guestEmail                String?
  status                    OrderStatus   @default(PENDING)
  subtotal                  Decimal       @db.Decimal(10, 2)
  discount                  Decimal       @default(0) @db.Decimal(10, 2)
  tax                       Decimal       @default(0) @db.Decimal(10, 2)
  deliveryFee               Decimal       @default(0) @db.Decimal(10, 2)
  total                     Decimal       @db.Decimal(10, 2)
  couponId                  String?
  coupon                    Coupon?       @relation(fields: [couponId], references: [id])
  couponCode                String?
  addressSnapshot           Json
  estimatedDeliveryMinutes  Int?
  notes                     String?
  cancelledReason           String?
  items                     OrderItem[]
  payments                  Payment[]
  statusEvents              OrderStatusEvent[]
  couponUsages              CouponUsage[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
}

model OrderItem {
  id                   String   @id @default(uuid())
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId           String?
  menuItem             MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  nameSnapshot         String
  priceSnapshot        Decimal  @db.Decimal(10, 2)
  quantity             Int
  specialInstructions  String?
  optionsSnapshot      Json     @default("[]")
  addonsSnapshot       Json     @default("[]")
  lineTotal            Decimal  @db.Decimal(10, 2)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([orderId])
}

model OrderStatusEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id                 String         @id @default(uuid())
  orderId            String
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method             PaymentMethod
  status             PaymentStatus  @default(PENDING)
  amount             Decimal        @db.Decimal(10, 2)
  currency           String         @default("INR")
  provider           String
  razorpayOrderId    String?
  razorpayPaymentId  String?
  razorpaySignature  String?
  failureReason      String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([orderId])
  @@index([razorpayOrderId])
}

model Coupon {
  id               String       @id @default(uuid())
  code             String       @unique
  description      String?
  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2)
  minOrder         Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount      Decimal?     @db.Decimal(10, 2)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  perCustomerLimit Int?
  isActive         Boolean      @default(true)
  usages           CouponUsage[]
  orders           Order[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([couponId, orderId])
  @@index([userId])
}

model Favorite {
  userId     String
  menuItemId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, menuItemId])
}

model RestaurantSettings {
  id                         String                @id @default("default")
  name                       String
  legalName                  String?
  phone                      String
  email                      String?
  addressLine1               String
  addressLine2               String?
  city                       String
  state                      String
  pincode                    String
  country                    String                @default("India")
  logoUrl                    String
  instagramUrl               String?
  linkedinUrl                String?
  whatsappNumber             String?
  whatsappOrderingEnabled    Boolean               @default(true)
  mapsQuery                  String
  openStatus                 RestaurantOpenStatus  @default(OPEN)
  useScheduledHours          Boolean               @default(true)
  deliveryFee                Decimal               @default(0) @db.Decimal(10, 2)
  minOrder                   Decimal               @default(0) @db.Decimal(10, 2)
  freeDeliveryThreshold      Decimal?              @db.Decimal(10, 2)
  taxPercent                 Decimal               @default(0) @db.Decimal(5, 2)
  currency                   String                @default("INR")
  deliveryRadiusKm           Decimal?              @db.Decimal(6, 2)
  estimatedDeliveryMinutes   Int                   @default(45)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
}

model OpeningHours {
  id        String  @id @default(uuid())
  dayOfWeek Int
  openTime  String
  closeTime String
  isClosed  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dayOfWeek])
}

model DeliveryZone {
  id          String   @id @default(uuid())
  name        String
  isActive    Boolean  @default(true)
  pincodes    String[]
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role?
  type      String
  title     String
  body      String
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([role, createdAt])
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  message   String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

model GalleryImage {
  id        String      @id @default(uuid())
  url       String
  alt       String
  kind      GalleryKind @default(FOOD)
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Testimonial {
  id          String   @id @default(uuid())
  authorName  String
  body        String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LegalPage {
  slug      String   @id
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
